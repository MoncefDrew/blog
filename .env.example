# Turso Database Configuration
VITE_TURSO_DATABASE_URL=libsql://your-database-name.turso.io
VITE_TURSO_AUTH_TOKEN=your-turso-auth-token-here

# UploadThing Token for Image Uploads
VITE_UPLOADTHING_TOKEN=your-uploadthing-token-here

# Primary Writer Account
VITE_WRITER_EMAIL=
VITE_WRITER_USERNAME=
VITE_WRITER_PASSWORD=
VITE_WRITER_NAME=

# The Only Other Authorized Account (Configured in .env)
VITE_OTHER_WRITER_EMAIL=
VITE_OTHER_WRITER_USERNAME=
VITE_OTHER_WRITER_PASSWORD=
VITE_OTHER_WRITER_NAME=
